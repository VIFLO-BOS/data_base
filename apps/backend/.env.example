NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://annotator:local_password@localhost:5432/annotator_platform
# Use a direct connection for migrations; runtime uses transaction pooling on Vercel.
DATABASE_MIGRATION_URL=postgresql://annotator:local_password@localhost:5432/annotator_platform
DATABASE_SSL=false
# Hosted: true, verified provider CA when needed (PEM with escaped newlines).
# DATABASE_SSL_CA=
DATABASE_POOL_MAX=3
# Preview deploys must use a separate database and DATABASE_ENV=preview.
DATABASE_ENV=development
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Paylio <verified-sender@example.com>"
# One-time controlled seed operation. Remove credentials after provisioning.
BOOTSTRAP_ADMIN=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=
